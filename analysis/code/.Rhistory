roi_levels = NULL, out_png = NULL,
width = 4, height = 3, res = 300,
show_sig = TRUE, p_adjust = "none") {
m <- rlang::sym(measure)
# summary stats for bars + SD
df_sum <- df %>%
dplyr::filter(category == category_name) %>%
dplyr::group_by(age_bin, ROI) %>%
dplyr::summarise(
mean = mean(!!m, na.rm = TRUE),
sd   = sd(!!m,   na.rm = TRUE),
n    = sum(!is.na(!!m)),
.groups = "drop"
)
if (!is.null(roi_levels)) {
df_sum <- df_sum %>% dplyr::mutate(ROI = factor(ROI, levels = roi_levels))
}
p <- ggplot(df_sum, aes(x = age_bin, y = mean, fill = age_bin)) +
geom_col(width = 0.75) +
geom_errorbar(aes(ymin = mean - sd, ymax = mean + sd),
width = 0.18, linewidth = 0.8) +
facet_grid(~ ROI) +
labs(y = ylab, x = NULL) +
scale_fill_manual(values = fills, drop = FALSE) +
scale_y_continuous(breaks = y_breaks, limits = y_limits, expand = c(0, 0)) +
scale_x_discrete(expand = c(0, 0.4)) +
theme_classic(base_family = "Avenir") +
theme(
legend.position = "none",
axis.title.y = element_text(size = 18),
axis.text.y  = element_text(size = 14),
axis.text.x  = element_blank(),
axis.ticks.x = element_blank(),
panel.spacing = unit(0.75, "lines"),
strip.background = element_blank(),
strip.text.x = element_text(size = 14, face = "plain"),
plot.margin = margin(4, 4, 2, 4)
)
# ---- significance annotation (bracket + stars) ----
if (isTRUE(show_sig)) {
tt <- compute_sig_by_roi(df, category_name, measure, adjust = p_adjust)
# y position per ROI: slightly above the tallest bar+sd
ypad <- if (!is.null(y_limits)) diff(y_limits) * 0.06 else 0.06 * diff(range(df_sum$mean + df_sum$sd, na.rm = TRUE))
y_top <- df_sum %>%
dplyr::group_by(ROI) %>%
dplyr::summarise(y = max(mean + sd, na.rm = TRUE) + ypad, .groups = "drop")
ann <- tt %>%
dplyr::left_join(y_top, by = "ROI") %>%
dplyr::mutate(
x    = "Child (10–12)",
xend = "Teen (13–16)",
yend = y,
label = stars
) %>%
dplyr::filter(label != "")
# bracket height (little vertical ticks)
tick <- if (!is.null(y_limits)) diff(y_limits) * 0.02 else 0.02 * diff(range(df_sum$mean + df_sum$sd, na.rm = TRUE))
p <- p +
geom_segment(
data = ann,
aes(x = x, xend = xend, y = y, yend = yend),
inherit.aes = FALSE, linewidth = 0.8
) +
geom_segment(
data = ann,
aes(x = x, xend = x, y = y, yend = y - tick),
inherit.aes = FALSE, linewidth = 0.8
) +
geom_segment(
data = ann,
aes(x = xend, xend = xend, y = y, yend = y - tick),
inherit.aes = FALSE, linewidth = 0.8
) +
geom_text(
data = ann,
aes(x = "Teen (13–16)", y = y + tick*0.35, label = label),
nudge_x = -0.5,
inherit.aes = FALSE,
family = "Avenir", fontface = "bold", size = 5
)
}
if (!is.null(out_png)) {
png(out_png, units = "in", width = width, height = height, res = res)
print(p)
dev.off()
}
p
}
