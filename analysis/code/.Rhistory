# Two shades per category: child (lighter), teen (darker)
fill_face  <- c("Child (10–12)" = "#FF4D4D", "Teen (13–16)" = "#8B0000")
fill_body  <- c("Child (10–12)" = "#F2DA3A", "Teen (13–16)" = "#BA8E23")
fill_place <- c("Child (10–12)" = "#33A333", "Teen (13–16)" = "#013220")
# Order for the 4 bars per facet
x_levels <- c(
"Child (10–12).lh",
"Child (10–12).rh",
"Teen (13–16).lh",
"Teen (13–16).rh"
)
# Control facet spacing (fixes “middle bars too close” problem)
facet_spacing_x <- unit(0.8, "lines")
# Star horizontal placement tweak:
# 0.00 = centered on Teen.<hemi> bar
# negative = move left; positive = move right
star_nudge_x <- -0.35
df.10_16_hemi <- df.centers_cat %>%
filter(age >= 10, age <= 16) %>%
mutate(
age_bin = case_when(
age >= 10 & age <= 12 ~ "Child (10–12)",
age >= 13 & age <= 16 ~ "Teen (13–16)",
TRUE ~ NA_character_
),
age_bin = factor(age_bin, levels = c("Child (10–12)", "Teen (13–16)")),
hemi    = factor(hemi, levels = c("lh","rh"))
) %>%
filter(!is.na(age_bin)) %>%
filter(
hemi %in% c("lh","rh"),
ROI %in% c("pSTS_faces", "pFus_faces", "OTS_bodies", "ITG_limbs", "CoS_places", "IPS_places")
) %>%
na.omit()
# OPTIONAL sanity check:
# df.10_16_hemi %>% count(category, ROI, hemi, age_bin)
p_to_stars <- function(p) dplyr::case_when(
is.na(p)  ~ "",
p < 0.001 ~ "***",
p < 0.01  ~ "**",
p < 0.05  ~ "*",
TRUE      ~ ""
)
# Compute Welch t-test per ROI × hemi: Child vs Teen
# adjust can be: "none" (uncorrected), "BH", etc.
compute_sig_by_roi_hemi <- function(df, category_name, measure, adjust = "none") {
m <- rlang::sym(measure)
df %>%
filter(category == category_name) %>%
group_by(ROI, hemi) %>%
summarise(
p_value = tryCatch({
x1 <- filter(cur_data(), age_bin == "Child (10–12)") %>% pull(!!m)
x2 <- filter(cur_data(), age_bin == "Teen (13–16)")  %>% pull(!!m)
if (length(x1) < 2 || length(x2) < 2) NA_real_
else t.test(x1, x2, var.equal = FALSE)$p.value
}, error = function(e) NA_real_),
.groups = "drop"
) %>%
mutate(
p_adj = p.adjust(p_value, method = adjust),
stars = p_to_stars(p_adj)
)
}
make_fourBar_plot <- function(df, category_name, measure, ylab, fills,
y_breaks = waiver(), y_limits = NULL,
roi_levels = NULL,
out_png = NULL, width = 4, height = 3, res = 300,
show_sig = TRUE, p_adjust = "none",
star_nudge = -0.35) {
m <- rlang::sym(measure)
# Summaries for bar heights + SD
df_sum <- df %>%
filter(category == category_name) %>%
group_by(age_bin, hemi, ROI) %>%
summarise(
mean = mean(!!m, na.rm = TRUE),
sd   = sd(!!m,   na.rm = TRUE),
n    = sum(!is.na(!!m)),
.groups = "drop"
) %>%
mutate(
x = interaction(age_bin, hemi, sep = "."),
x = factor(x, levels = x_levels)
)
if (!is.null(roi_levels)) {
df_sum <- df_sum %>% mutate(ROI = factor(ROI, levels = roi_levels))
}
p <- ggplot(df_sum, aes(x = x, y = mean, fill = age_bin)) +
geom_col(width = 0.72) +
geom_errorbar(aes(ymin = mean - sd, ymax = mean + sd),
width = 0.16, linewidth = 0.8) +
facet_grid(~ ROI) +
labs(y = ylab, x = NULL) +
scale_fill_manual(values = fills, drop = FALSE) +
scale_y_continuous(breaks = y_breaks, limits = y_limits, expand = c(0, 0)) +
scale_x_discrete(expand = c(0, 0.35)) +
theme_classic(base_family = "Avenir") +
theme(
legend.position = "none",
axis.title.y = element_text(size = 18),
axis.text.y  = element_text(size = 14),
axis.text.x  = element_blank(),
axis.ticks.x = element_blank(),
panel.spacing.x = facet_spacing_x,
strip.background = element_blank(),
strip.text.x = element_text(size = 14, face = "plain"),
plot.margin = margin(4, 4, 2, 4)
)
if (isTRUE(show_sig)) {
tt <- compute_sig_by_roi_hemi(df, category_name, measure, adjust = p_adjust) %>%
filter(stars != "")
# Place brackets slightly above the tallest bar+sd in each ROI
ypad <- if (!is.null(y_limits)) diff(y_limits) * 0.06 else
0.06 * diff(range(df_sum$mean + df_sum$sd, na.rm = TRUE))
tick <- if (!is.null(y_limits)) diff(y_limits) * 0.02 else
0.02 * diff(range(df_sum$mean + df_sum$sd, na.rm = TRUE))
y_top <- df_sum %>%
group_by(ROI) %>%
summarise(y = max(mean + sd, na.rm = TRUE) + ypad, .groups = "drop")
ann <- tt %>%
left_join(y_top, by = "ROI") %>%
mutate(
# bracket compares Child.<hemi> to Teen.<hemi>
x    = paste0("Child (10–12).", hemi),
xend = paste0("Teen (13–16).", hemi),
yend = y
)
p <- p +
# horizontal bracket
geom_segment(
data = ann,
aes(x = x, xend = xend, y = y, yend = yend),
inherit.aes = FALSE, linewidth = 0.8
) +
# left tick
geom_segment(
data = ann,
aes(x = x, xend = x, y = y, yend = y - tick),
inherit.aes = FALSE, linewidth = 0.8
) +
# right tick
geom_segment(
data = ann,
aes(x = xend, xend = xend, y = y, yend = y - tick),
inherit.aes = FALSE, linewidth = 0.8
) +
# stars (anchor on Teen.<hemi> and nudge left toward center)
geom_text(
data = ann,
aes(x = xend, y = y + tick*0.35, label = stars),
inherit.aes = FALSE,
nudge_x = star_nudge,
family = "Avenir", fontface = "bold", size = 5
)
}
if (!is.null(out_png)) {
png(out_png, units = "in", width = width, height = height, res = res)
print(p)
dev.off()
}
p
}
